#: ../plugin.py:87
#, python-format
msgid ""
"Fetching and saving %s.xml succeeded.\n"
"Restart now for changes to take immediate effect?"
msgstr ""
"Noutaminen ja tallentaminen %s.xml onnistuivat.\n"
"Käynnistettäänkö uudelleen nyt, jotta muutokset tulevat voimaan?"

#: ../plugin.py:68
msgid "File being updated, i.e. satellites.xml, cables.xml, or terrestrial.xml."
msgstr "Päivitettävä tiedosto eli satellites.xml, cables.xml, tai terrestrial.xml."

#: ../plugin.py:69
msgid "Folder where the downloaded file will be saved. \"/etc/tuxbox\" is the default location. Files stored in \"/etc/enigma2\" override the default file and are not updated on a software update."
msgstr "Kansio, johon ladattu tiedosto tallennetaan. \"/etc/tuxbox\" on oletussijainti. \"/etc/enigma2\" kansioon tallennetut tiedostot ohittavat oletus tiedoston, eikä niitä päivitetä ohjelmistopäivityksessä."

#: ../plugin.py:140
msgid "For updating transponder xml files"
msgstr "Transponderin xml-tiedostojen päivittämiseen"

#: ../plugin.py:34
msgid "OE-Alliance"
msgstr "OE-Alliance"

#: ../plugin.py:67
msgid "Online source where the transponder xml file is being retrieved from."
msgstr "Online lähde, josta haetaan transponderi xml-tiedosto."

#: ../plugin.py:69
msgid "Save to"
msgstr "Tallenna nimellä"

#: ../plugin.py:84
#, python-format
